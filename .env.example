# CineAI Studio - Environment Configuration Example

# API Configuration
PORT=5000
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5000

# Database Configuration (Supabase / PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cineai_db
DB_USER=postgres
DB_PASSWORD=postgres_password_here
DATABASE_URL=Server=localhost;Port=5432;Database=cineai_db;User Id=postgres;Password=postgres_password_here;

# Supabase Storage Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=cineai

# AI Service Credentials (Gemini & Veo 3.1)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
VEO_MODEL=veo-3.1-generate-preview

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_long
JWT_ISSUER=CineAI.API
JWT_AUDIENCE=CineAI.Web

# Redis & Hangfire Worker Queue
REDIS_CONNECTION_STRING=localhost:6379

# SignalR Realtime Hub
SIGNALR_HUB_URL=http://localhost:5000/hubs/video-generation

# Next.js Web Client
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SIGNALR_URL=http://localhost:5000/hubs/video-generation
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
